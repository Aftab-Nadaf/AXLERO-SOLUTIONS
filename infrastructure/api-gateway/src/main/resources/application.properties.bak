spring.application.name=api-gateway

server.port=8083

eureka.client.service-url.defaultZone=http://localhost:8761/eureka/
eureka.client.register-with-eureka=true
eureka.client.fetch-registry=true

# Product Service

spring.cloud.gateway.server.webmvc.routes[0].id=product-service
spring.cloud.gateway.server.webmvc.routes[0].uri=lb://PRODUCT-SERVICE
spring.cloud.gateway.server.webmvc.routes[0].predicates[0]=Path=/api/products,/api/products/**
spring.cloud.gateway.server.webmvc.routes[0].filters[0]=StripPrefix=1


# Inventory Service

spring.cloud.gateway.server.webmvc.routes[1].id=inventory-service
spring.cloud.gateway.server.webmvc.routes[1].uri=lb://INVENTORY-SERVICE
spring.cloud.gateway.server.webmvc.routes[1].predicates[0]=Path=/api/inventory,/api/inventory/**
spring.cloud.gateway.server.webmvc.routes[1].filters[0]=StripPrefix=1


# Recommendation Service

spring.cloud.gateway.server.webmvc.routes[2].id=recommendation-service
spring.cloud.gateway.server.webmvc.routes[2].uri=lb://RECOMMENDATION-SERVICE
spring.cloud.gateway.server.webmvc.routes[2].predicates[0]=Path=/api/recommendations,/api/recommendations/**
spring.cloud.gateway.server.webmvc.routes[2].filters[0]=StripPrefix=1